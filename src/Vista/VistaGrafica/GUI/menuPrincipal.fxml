<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" style="-fx-underline: hover;" styleClass="menuPrincipal" stylesheets="@css/menuPrincipal.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Vista.VistaGrafica.MenuPrincipalController">
   <top>
      <Label alignment="TOP_CENTER" text="THE GAME (Quick &amp; Easy)" textFill="WHITE" BorderPane.alignment="CENTER">
         <font>
            <Font name="Franklin Gothic Heavy" size="28.0" />
         </font>
         <opaqueInsets>
            <Insets />
         </opaqueInsets>
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="35.0" />
         </padding>
      </Label>
   </top>
   <bottom>
      <Label fx:id="lbUniendose" alignment="TOP_CENTER" text="Esperando mas jugadores..." textFill="WHITE" BorderPane.alignment="TOP_CENTER">
         <font>
            <Font size="22.0" />
         </font>
         <BorderPane.margin>
            <Insets bottom="60.0" />
         </BorderPane.margin>
      </Label>
   </bottom>
   <center>
      <VBox alignment="CENTER" prefHeight="200.0" prefWidth="100.0" BorderPane.alignment="CENTER">
         <children>
            <TextField fx:id="nombreJugador" alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="30.0" prefWidth="250.0" promptText="Ingrese su nombre">
               <VBox.margin>
                  <Insets bottom="30.0" />
               </VBox.margin>
            </TextField>
            <Button fx:id="btnUnirsePartida" disable="true" mnemonicParsing="false" onAction="#onUnirse" text="UNIRSE A LA PARTIDA" textAlignment="CENTER">
               <font>
                  <Font size="21.0" />
               </font>
            </Button>
         </children>
      </VBox>
   </center>
</BorderPane>
